# .env.example — 복사해서 저장소 맨 위에 .env로 만들고 실제 값을 넣는다. .env는 커밋하지 않는다.
# NCP Cloud Functions에서는 같은 이름을 액션 기본 파라미터에 넣는다.
# AI 키는 사람마다 따로(11/24): 미리가 미리 계정에서 발급해 전해 준 자기 키만 넣는다. 다른 사람과 나누지 않는다.
# Claude는 vcc-dev(ww)·vcc-dev(minji)처럼 사람별 키, CLOVA도 사람별 키. Claude 비용은 미리 부담, CLOVA는 대회 크레딧에서 차감.
# 키별 한도가 없으니 오늘 사용액은 python -X utf8 functions/ai_usage.py 로 본다(/token은 아래 ANTHROPIC_ADMIN_KEY·NCP 키로 실제 청구까지).
CLOVA_KEY=
ANTHROPIC_API_KEY=
# (미리만, 선택) /token 실제 청구 조회용 Admin 키(sk-ant-admin…). 없으면 이 PC 로그 추정. AI 호출에는 쓰지 않는다.
ANTHROPIC_ADMIN_KEY=
# 로그인 비번 표(JSON 문자열, 한 줄). "*"는 가상학생 전원(H0001~H1000)의 공용 비번 — 청중 체험용.
# 시연 계정은 개별 항목으로 따로(개별 항목이 "*"보다 우선). 직원(staff01·02)은 "*"가 적용되지 않으니 반드시 적는다.
# 여기에 없는 학번은 로그인되지 않는다. data/에는 비번을 두지 않는다.
VCC_LOGIN_PW={"*":"...","H0143":"...","H0469":"...","H0241":"...","H0745":"...","staff01":"...","staff02":"..."}
# [작업 58] Object Storage(공개 주소 기록). 액션에는 같은 이름을 기본 파라미터로. 로컬에서는 시험(functions/cloud/test_store_ncp_live.py)과
# 공개 기록 초기화(python reset_runtime.py --ncp)에만 쓴다. 키는 Sub Account vcc-storage의 API 인증키.
NCP_OS_BUCKET=
NCP_OS_ACCESS_KEY=
NCP_OS_SECRET_KEY=
