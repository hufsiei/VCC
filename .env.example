# .env.example — 복사해서 저장소 맨 위에 .env로 만들고 실제 값을 넣는다. .env는 커밋하지 않는다.
# NCP Cloud Functions에서는 같은 이름을 액션 기본 파라미터에 넣는다.
CLOVA_KEY=
ANTHROPIC_API_KEY=
# 로그인 비번 표(JSON 문자열, 한 줄). 여기에 없는 학번은 로그인되지 않는다. data/에는 비번을 두지 않는다.
VCC_LOGIN_PW={"H0143":"...","H0469":"...","H0241":"...","H0745":"...","staff01":"...","staff02":"..."}
